generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// 계약 업체 DB — 구두/서면 계약만 맺고 상세 정보를 아직 못 받은 업체 명단.
/// Vendor(정식 입점 업체)와 별개로, 최소 정보만 빠르게 쌓아두기 위한 테이블입니다.
model ContractedVendor {
  id           Int            @id @default(autoincrement())
  name         String // 업체명
  contractType String // written(계약서 작성) | verbal(구두 계약만)
  phone        String? // 전화번호 — 아직 못 받은 곳이 많아 선택 입력
  address      String? // 주소 — 아직 못 받은 곳이 많아 선택 입력
  managerName  String? // DB담당자 (필수 입력, app 레벨에서 검증)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memos        ContractMemo[]

  @@map("contracted_vendors")
}

/// 계약 업체 진행 메모 — 시간순으로 쌓이는 기록. 메모마다 진행 상태와 날짜를 함께 남긴다.
/// 업체의 "현재 상태"는 별도 컬럼이 아니라 가장 최근 메모의 status 로 정한다 —
/// 메모 없이는 상태도 없고, 메모를 지우면 상태도 함께 사라져야 두 값이 어긋나지 않는다.
model ContractMemo {
  id                 Int              @id @default(autoincrement())
  contractedVendorId Int
  contractedVendor   ContractedVendor @relation(fields: [contractedVendorId], references: [id], onDelete: Cascade)
  status             String // recontact(재컨텍요망) | longterm(장기가망) | scheduled(미팅예정) | consulted(미팅완료) | contracted(계약완료)
  content            String           @db.Text
  /// 이 메모를 남긴 시각 = "그 날 한 일"의 날짜. 달력·어제/오늘 요약·날짜 보기가 전부 이 값을 KST 하루로 잘라 쓴다.
  createdAt          DateTime         @default(now())
  /// 다음에 언제 연락할지 — 선택 입력이라 대개 비어 있다. 앞으로 할 일이지 지나간 활동이 아니므로
  /// 활동 집계에는 절대 섞지 않는다(레일의 "다음 연락 예정"과 달력의 예정 표시에만 쓴다).
  nextContactAt      DateTime?        @db.Date
  /// @deprecated 예전엔 메모마다 사용자가 고르던 날짜. "언제 했다"(과거)와 "언제 할 거다"(미래)를
  /// 한 칸이 겸하는 바람에 달력이 앞으로 할 일까지 활동으로 세고 있었다. 지금은 활동=createdAt,
  /// 예정=nextContactAt 으로 나뉘었고 이 컬럼은 앱 어디서도 읽지 않는다.
  /// 운영 DB에 백업이 없어 과거 기록의 원본으로 남겨둔다. 스키마에서 빼면 migrate 가 DROP 을 만든다.
  memoDate           DateTime?        @db.Date

  @@index([contractedVendorId, createdAt])
  // 달력 한 장 = 42일치를 createdAt 범위로 훑는다. 위 복합 인덱스는 선행 컬럼이 달라 못 쓴다.
  @@index([createdAt])
  @@index([nextContactAt])
  @@map("contract_memos")
}

model Vendor {
  id                 Int      @id @default(autoincrement())
  category           String // wedding_hall, studio, dress ... (기획서 3절 14종 고정값)
  name               String
  authorName         String? // 작성자 — 정보를 기입한 담당 직원명 (필수 입력, app 레벨에서 검증)
  contact            String? // 업체연락처
  businessHoursStart String? // "10:00"
  businessHoursEnd   String? // "19:00"
  region             String?
  address            String?
  products           Json? // [{ name, description }] — 상품구성, +/- 로 여러 개 등록
  description        String?  @db.Text
  styleMoods         String[] // 자유 입력 해시태그 (기획서 8절, 고정 목록 아님)
  options            Json? // [{ name, price, desc }]
  sdingBenefit       String?  @db.Text
  categoryData       Json? // 업종별 전용 필드 (기획서 6절)
  photos             Json? // [{ url, type: "main"|"gallery"|"dress"|"video", label, sortOrder }]
  //                          type="video" 는 영상(DVD) 업종의 샘플 영상입니다.
  //                          사진 URL 은 여기 말고 products[].photos 에도 들어가므로,
  //                          파일 정리는 필드를 열거하지 말고 lib/storage 의
  //                          collectBucketPaths() 로 레코드 전체를 훑어야 합니다.
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("vendors")
}
